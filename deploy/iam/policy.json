{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeTenantLifecycleQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "${tenant_lifecycle_tenderacl_queue_arn}",
        "${member_removal_tenderacl_queue_arn}"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${aws_region}:${aws_account_id}:log-group:/aws/eks/*:*"
    }
  ]
}
