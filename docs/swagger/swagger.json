{
    "swagger": "2.0",
    "info": {
        "description": "Restricted-tender access overlay, extracted from iam-org-membership per ADR-0007 Wave 3. Owns exactly one resource — tender_acl_entries — behind three admin-gated grant/revoke/list endpoints and one mesh-only authorization check.\n\n**Route prefixes.**  `/api/v1/*` — tenant-admin callers (`tender_admin`/`tenant_admin`/`tenant_owner`, via `x-tenant-roles`).  `/internal/*` — in-mesh service-to-service, mTLS trust boundary only, no RBAC/JWT check at all (LLD §8.2/§13.2).\n\nTAC-4 (the internal check) never returns 404 — a missing grant is a valid, cacheable `has_access:false` answer, not an error.",
        "title": "Tender ACL Service API",
        "contact": {
            "name": "BCBP Solutions"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "1.0"
    },
    "paths": {
        "/api/v1/tenants/{id}/tenders/{tender_id}/acl": {
            "get": {
                "security": [
                    {
                        "UserID": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "TenantRoles": []
                    }
                ],
                "description": "Every active-or-not entry for a tender, ordered by created_at. Not cached.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "TAC-1 — List tender ACL entries",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tender UUID",
                        "name": "tender_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "UserID": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "TenantRoles": []
                    }
                ],
                "description": "Blocks on a synchronous membership-existence check against iam-org-membership — fails closed (503 core_unavailable) if that check can't be performed.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "TAC-2 — Grant a tender ACL entry",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tender UUID",
                        "name": "tender_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Grant request",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.GrantRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/http.ACLResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/tenants/{id}/tenders/{tender_id}/acl/{user_id}": {
            "delete": {
                "security": [
                    {
                        "UserID": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "TenantRoles": []
                    }
                ],
                "description": "Soft-delete, idempotent in effect — revoking an already-revoked (or never-granted) entry is not an error.",
                "tags": [
                    "public"
                ],
                "summary": "TAC-3 — Revoke a tender ACL entry",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tender UUID",
                        "name": "tender_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User UUID",
                        "name": "user_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "infra"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/internal/tenants/{id}/tenders/{tender_id}/acl/{user_id}": {
            "get": {
                "description": "Mesh-only, no RBAC/JWT check at all. Never 404 — a missing grant is a valid, cacheable has_access:false answer. Cached 30s in Valkey.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal"
                ],
                "summary": "TAC-4 — Check tender access",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tender UUID",
                        "name": "tender_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User UUID",
                        "name": "user_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.CheckAccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "infra"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.ACLResponse": {
            "type": "object",
            "properties": {
                "access_level": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "granted_by": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "record_version": {
                    "type": "integer"
                },
                "tenant_id": {
                    "type": "string"
                },
                "tender_id": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "http.CheckAccessResponse": {
            "type": "object",
            "properties": {
                "access_level": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "has_access": {
                    "type": "boolean"
                }
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "trace_id": {
                    "type": "string"
                }
            }
        },
        "http.GrantRequest": {
            "type": "object",
            "required": [
                "access_level",
                "user_id"
            ],
            "properties": {
                "access_level": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "http.ListResponse": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.ACLResponse"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "public",
            "description": "Tenant-admin grant/revoke/list (TAC-1, TAC-2, TAC-3)"
        },
        {
            "name": "internal",
            "description": "Mesh-only authorization check (TAC-4/I-12) — no RBAC"
        },
        {
            "name": "infra",
            "description": "Health checks (unauthenticated)"
        }
    ],
    "securityDefinitions": {
        "TenantID": {
            "description": "Tenant UUID injected by the API gateway. Must match the :id path parameter (defense-in-depth alongside RLS) on /api/v1/* routes.",
            "type": "apiKey",
            "name": "x-tenant-id",
            "in": "header"
        },
        "TenantRoles": {
            "description": "Comma-separated tenant-role list injected by the API gateway. /api/v1/* routes require tender_admin, tenant_admin, or tenant_owner.",
            "type": "apiKey",
            "name": "x-tenant-roles",
            "in": "header"
        },
        "UserID": {
            "description": "Authenticated user UUID injected by the API gateway. Required on /api/v1/* routes only — /internal/* is mesh-only and carries no identity headers.",
            "type": "apiKey",
            "name": "x-user-id",
            "in": "header"
        }
    }
}
